# =========================================================
# Builder stage: build llama-cpp-python from GitHub source
# =========================================================
FROM ghcr.io/nvidia-ai-iot/vllm:latest-jetson-orin AS builder

WORKDIR /opt/orin

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/huggingface
ENV TRANSFORMERS_CACHE=/models/huggingface
ENV VENV_PATH=/opt/venv

RUN python3 -m venv ${VENV_PATH}
ENV PATH="${VENV_PATH}/bin:${PATH}"

RUN pip install --upgrade pip setuptools wheel scikit-build-core cmake ninja

RUN CMAKE_ARGS="-DGGML_CUDA=on" FORCE_CMAKE=1 \
    pip install --no-cache-dir --upgrade --force-reinstall \
    git+https://github.com/abetlen/llama-cpp-python.git

# =========================================================
# Runtime stage: keep Jetson vLLM runtime, add llama build
# =========================================================
FROM ghcr.io/nvidia-ai-iot/vllm:latest-jetson-orin

WORKDIR /opt/orin

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/models/huggingface
ENV TRANSFORMERS_CACHE=/models/huggingface
ENV VENV_PATH=/opt/venv
ENV PATH="${VENV_PATH}/bin:${PATH}"

ENV PRIMER_BACKEND=
ENV PRIMER_MODEL_ID=
ENV PRIMER_MODEL_PATH=
ENV PRIMER_TOKENIZER_ID=
ENV PRIMER_MAX_MODEL_LEN=4096
ENV PRIMER_MAX_NEW_TOKENS=1400
ENV PRIMER_TEMPERATURE=0.1
ENV PRIMER_TOP_P=0.95
ENV PRIMER_GPU_MEMORY_UTILIZATION=0.50
ENV PRIMER_TENSOR_PARALLEL_SIZE=1
ENV PRIMER_N_GPU_LAYERS=-1
ENV PRIMER_N_THREADS=6
ENV PRIMER_N_BATCH=512

COPY --from=builder /opt/venv /opt/venv
FROM orin-gw:5000/primer-runtime:jetson-orin.0.2

WORKDIR /app

COPY federation/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY federation /app/federation
COPY common /app/common

EXPOSE 8080

ENTRYPOINT []
CMD ["python3", "-m", "uvicorn", "federation.app:app", "--host", "0.0.0.0", "--port", "8080"]